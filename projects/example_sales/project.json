{
  "project_name": "ExampleSales",
  "title": {"en": "Sales performance", "ar": "أداء المبيعات"},
  "language": "en",
  "approval": {
    "status": "APPROVED",
    "approved_by": "Example business owner",
    "approved_on": "2026-08-19",
    "notes": "Example project shipped with the template. Replace it for a real adaptation."
  },
  "business": {
    "purpose": "Replace the monthly manual sales workbook.",
    "decision_supported": "Where is revenue growing, and which customers need attention.",
    "run_frequency": "monthly"
  },
  "sources": [
    {
      "id": "sales",
      "title": "Monthly sales export",
      "match": ["sales_*.xlsx"],
      "format": "xlsx",
      "sheet": "Sales",
      "header_row": 1,
      "grain": "One row is one invoice line.",
      "business_key": ["invoice_no", "line_no"],
      "corrections_allowed": true,
      "missing_record_policy": "keep",
      "columns": [
        {"source": "Invoice No", "field": "invoice_no", "type": "text", "required": true},
        {"source": "Line", "field": "line_no", "type": "integer", "required": true},
        {"source": "Invoice Date", "field": "invoice_date", "type": "date", "required": true},
        {"source": "Customer ID", "field": "customer_id", "type": "text", "required": true},
        {"source": "Product", "field": "product", "type": "text"},
        {"source": "Quantity", "field": "quantity", "type": "number", "required": true},
        {"source": "Unit Price", "field": "unit_price", "type": "number", "required": true},
        {"source": "Amount", "field": "amount", "type": "number", "required": true},
        {"source": "Status", "field": "status", "type": "text"}
      ],
      "filters": [
        {"field": "status", "operator": "not_equals", "value": "Cancelled"}
      ],
      "checks": [
        {"type": "unique", "fields": ["invoice_no", "line_no"], "on_fail": "quarantine"},
        {"type": "range", "field": "quantity", "min": 0, "on_fail": "quarantine"},
        {"type": "not_future", "field": "invoice_date", "on_fail": "quarantine"},
        {"type": "allowed_values", "field": "status", "values": ["Posted", "Draft", "Cancelled"],
         "on_fail": "quarantine"}
      ],
      "control_totals": [{"field": "amount", "precision": 2}]
    },
    {
      "id": "customers",
      "title": "Customer master",
      "match": ["customers*.xlsx"],
      "format": "xlsx",
      "sheet": "Customers",
      "grain": "One row is one customer.",
      "business_key": ["customer_id"],
      "corrections_allowed": true,
      "missing_record_policy": "keep",
      "columns": [
        {"source": "Customer ID", "field": "customer_id", "type": "text", "required": true},
        {"source": "Customer Name", "field": "customer_name", "type": "text", "required": true},
        {"source": "Segment", "field": "segment", "type": "text"},
        {"source": "Country", "field": "country", "type": "text"}
      ],
      "checks": [{"type": "unique", "fields": ["customer_id"], "on_fail": "quarantine"}]
    }
  ],
  "relationships": [
    {"child": "sales", "child_fields": ["customer_id"], "parent": "customers",
     "parent_fields": ["customer_id"], "on_missing": "warn"}
  ],
  "metrics_sql": "sql/metrics.sql",
  "dashboard": {
    "kpis": ["total_amount", "invoice_count", "average_invoice_value", "customers_served"],
    "charts": [{"metric": "amount_by_month", "chart": "bar"},
               {"metric": "amount_by_segment", "chart": "bar"}],
    "tables": ["top_customers"]
  },
  "insights": [
    {"id": "small_average_invoice",
     "when": {"metric": "average_invoice_value", "operator": "<", "value": 500},
     "severity": "watch",
     "title": "Average invoice value is low",
     "body": "The average invoice is {value}, below the 500 review threshold."}
  ],
  "quality_gates": {
    "block_on_reconciliation_failure": true,
    "max_rejected_percent": 20,
    "archive_keep_runs": 10
  }
}
